generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BuyerStatus {
  lead
  active
  dormant
}

enum BuyerType {
  retailer
  wholesaler
  agent
  brand
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum InquiryStatus {
  new
  replied
  closed
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String     @unique
  imgUrl   String?
  isActive Boolean    @default(true)
  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamp(3)
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int              @id @default(autoincrement())
  sku         String           @unique
  name        String
  slug        String           @unique
  description String
  isActive    Boolean          @default(true)
  imagesReady Boolean          @default(false)
  hsCode      String?
  moq         String?
  categories  Category[]
  variants    ProductVariant[]
  images      ProductImage[]
  artisanId   Int?
  artisan     Artisan?         @relation(fields: [artisanId], references: [id])
  inquiries   Inquiry[]
  status      ProductStatus    @default(DRAFT)
  createdAt   DateTime         @default(now()) @db.Timestamp(3)
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String

  material String
  size     String
  color    String

  weightKg Float?
  lengthCm Float?
  widthCm  Float?
  heightCm Float?

  product   Product    @relation(fields: [productId], references: [id])
  prices    Price[]
  inventory Inventory?

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt
}

model Price {
  id        Int            @id @default(autoincrement())
  variantId Int
  currency  String
  amount    Float
  minQty    Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  createdAt DateTime       @default(now()) @db.Timestamp(3)
  updatedAt DateTime       @updatedAt

  @@unique([variantId, currency, minQty])
}

model Inventory {
  id        Int            @id @default(autoincrement())
  variantId Int            @unique
  quantity  Int
  warehouse String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  createdAt DateTime       @default(now()) @db.Timestamp(3)
  updatedAt DateTime       @updatedAt
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  publicId  String  @unique
  url       String
  width     Int?
  height    Int?
  altText   String?
  position  Int?

  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt
}

model Artisan {
  id               Int      @id @default(autoincrement())
  name             String
  location         String?
  materials        String[]
  monthlyCapacity  Int?
  reliabilityScore Int?
  notes            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]
}

model Buyer {
  id          String  @id @default(uuid())
  name        String?
  email       String  @unique
  country     String?
  companyName String?
  phone       String?

  type   BuyerType?
  status BuyerStatus @default(lead)

  lastContactAt DateTime?
  notes         String?

  inquiries Inquiry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([country])
  @@index([status])
}

model Inquiry {
  id      String        @id @default(uuid())
  message String
  country String?
  status  InquiryStatus @default(new)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  source      String?
  inquiryType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([productId])
}
